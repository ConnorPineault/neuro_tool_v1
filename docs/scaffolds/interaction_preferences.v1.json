  "options": {
    "input_mode": ["text", "voice", "mixed"],
    "output_mode": ["text_only", "text_with_read_aloud"],
    "voice_reply_mode": ["off", "on_demand", "always_on"],
    "tone_style": ["warm", "neutral", "structured", "minimal"],
    "prompt_length": ["short", "standard", "expanded"],
    "offer_examples_mode": ["on_request", "proactive"],
    "rephrase_style": ["simpler", "more_detailed", "same_meaning_different_words"],
    "pace": ["standard", "slow"],
    "auto_advance": ["never", "after_confirmation"],
    "progress_style": ["section_only", "detailed", "hidden"],
    "font_size": ["standard", "large", "extra_large"],
    "question_typing_effect": ["off", "on"],
    "question_typing_speed": ["standard", "slow", "slower"],
    "contrast_mode": ["default", "high_contrast", "soft_contrast"],
    "summary_length": ["brief", "standard"]
  }
