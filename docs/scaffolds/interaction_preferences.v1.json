{
  "version": "v1-draft",
  "defaults": {
    "input_mode": "text",
    "output_mode": "text_only",
    "voice_reply_mode": "off",
    "captions_enabled": true,
    "repeat_button_enabled": true,
    "tone_style": "neutral",
    "prompt_length": "standard",
    "use_plain_language": true,
    "offer_examples_mode": "on_request",
    "rephrase_style": "same_meaning_different_words",
    "pace": "standard",
    "auto_advance": "after_confirmation",
    "pause_between_turns_ms": 0,
    "allow_interruptions_during_read_aloud": true,
    "wait_for_user_confirmation_before_next_question": true,
    "show_one_question_at_a_time": true,
    "show_progress_indicator": true,
    "progress_style": "section_only",
    "font_size": "standard",
    "question_typing_effect": "on",
    "question_typing_speed": "slow",
    "contrast_mode": "default",
    "reduced_motion": true,
    "hide_nonessential_ui": false,
    "summarize_before_next": true,
